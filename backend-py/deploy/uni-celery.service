[Unit]
Description=University Portal Celery Worker (scraper)
After=network.target redis-server.service postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/university-portal/backend-py
EnvironmentFile=/opt/university-portal/backend-py/.env
EnvironmentFile=-/etc/university-portal/openai.env
EnvironmentFile=/opt/university-portal/backend-py/.release.env
EnvironmentFile=-/etc/university-portal/snapshot-storage.env
EnvironmentFile=/etc/university-portal/database.env
LimitNOFILE=65536
ExecStart=/opt/university-portal/backend-py/.venv/bin/celery \
    -A app.tasks.celery_app worker --concurrency=8 --max-tasks-per-child=10 \
    --loglevel=info -Q scrape
ExecStop=/opt/university-portal/backend-py/.venv/bin/python \
    /opt/university-portal/backend-py/deploy/celery_stop.py \
    --main-pid $MAINPID \
    --celery-bin /opt/university-portal/backend-py/.venv/bin/celery
TimeoutStopSec=90
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
