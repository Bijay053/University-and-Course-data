modules = ["nodejs-24", "python-3.12", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend-py: FastAPI"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend-py: Celery worker"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Redis"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "recovery-pdf-budget-static-check"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "task233-latency-gates"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "task236-challenge-shell"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "task235-skip-counters"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "task237-flaky-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "full-scraper-regression"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "academic-level-migration"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "dated-catalogue-history-scale"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "fee-selection-concurrency"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "approval-guidance-scale"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "task-loop-resource-cleanup"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "initial-dispatch-concurrency"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "smoke-receipt-restore"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "acceptance-evidence-restore"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "public-course-card-guards"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "study-mode-semantics"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "study-mode-route-persistence"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "partial-release-recovery"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "surrey-catalogue-source-boundaries"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "lsbu-current-catalogue"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pending-import-reuse"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "selective-retry-safety"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "scrape-chat-ui"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "live-runtime-controls"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "surrey-streaming-safety"

[[workflows.workflow]]
name = "backend-py: FastAPI"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend-py && PYTHONPATH=. python -m uvicorn app.main:app --host 0.0.0.0 --port 8080 --reload"
waitForPort = 8080

[[workflows.workflow]]
name = "backend-py: Celery worker"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend-py && PYTHONPATH=. celery -A app.tasks.celery_app worker --concurrency=8 --loglevel=info -Q scrape,beat --beat"

[[workflows.workflow]]
name = "Redis"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "redis-server --bind 127.0.0.1 --port 6379 --save \"\" --appendonly no --loglevel notice"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "recovery-pdf-budget-static-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend-py && python -m pytest tests/test_recovery_pdf.py::TestNoPdfBudgetInlineConstruction -v"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "task233-latency-gates"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend-py && python -m pytest tests/test_gemini_timeout_circuit.py tests/test_browser_only_gate.py tests/test_vision_overall_gate.py -q"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "task236-challenge-shell"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend-py && PYTHONPATH=. python -m pytest tests/test_challenge_shell_detection.py -q -c /dev/null -p no:cacheprovider"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "task235-skip-counters"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend-py && PYTHONPATH=. python -m pytest tests/test_skip_counters.py -q -c /dev/null -p no:cacheprovider"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "task237-flaky-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend-py && PYTHONPATH=. python -m pytest tests/test_gemini_gate.py tests/test_browser_international_toggle.py -q -c /dev/null -p no:cacheprovider"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "full-scraper-regression"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -x /tmp/university-portal-db-validation.lock bash -c 'cd backend-py && PYTHONPATH=. python tests/helpers/run_disposable_redis.py --full-regression'"

[[workflows.workflow]]
name = "academic-level-migration"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -x /tmp/university-portal-db-validation.lock bash -c 'cd backend-py && ALLOW_ISOLATED_SCHEMA_MIGRATION_TESTS=1 PYTHONPATH=. python -m pytest tests/test_academic_level_migration_roundtrip.py -q -c /dev/null -p no:cacheprovider'"

[[workflows.workflow]]
name = "dated-catalogue-history-scale"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -x /tmp/university-portal-db-validation.lock bash -c 'cd backend-py && PYTHONPATH=. python -m pytest tests/test_winchester_catalogue_review.py::test_dated_catalogue_history_production_shape_latency_size_and_query_gate -q -c /dev/null -p no:cacheprovider'"

[[workflows.workflow]]
name = "fee-selection-concurrency"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -x /tmp/university-portal-db-validation.lock bash -c 'cd backend-py && ALLOW_ISOLATED_FEE_SELECTION_TESTS=1 python -m pytest tests/test_fee_selection_concurrency.py -q'"

[[workflows.workflow]]
name = "approval-guidance-scale"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -x /tmp/university-portal-db-validation.lock bash -c 'cd backend-py && PYTHONPATH=. python -m pytest tests/test_approval_guidance_scale.py tests/test_durable_approval_guidance.py -q -s -c /dev/null -p no:cacheprovider'"

[[workflows.workflow]]
name = "task-loop-resource-cleanup"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -x /tmp/university-portal-db-validation.lock bash -c 'cd backend-py && PYTHONPATH=. python tests/helpers/run_disposable_redis.py tests/test_task_loop_resource_cleanup.py tests/test_scrape_task_resource_cleanup.py tests/test_bulk_fix_job.py tests/test_stale_requeue.py tests/test_repair_scrape.py tests/test_phase3_learning.py tests/test_phase7_quality_actions.py tests/test_autonomous_verification_isolation.py -q -c /dev/null -o asyncio_mode=auto -p no:cacheprovider'"

[[workflows.workflow]]
name = "initial-dispatch-concurrency"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "flock -x /tmp/university-portal-db-validation.lock bash -c 'cd backend-py && ALLOW_ISOLATED_DISPATCH_TESTS=1 PYTHONPATH=. python -m pytest tests/test_initial_dispatch_concurrency.py tests/test_initial_dispatch_lock_cleanup.py -q -o asyncio_default_test_loop_scope=function -o asyncio_default_fixture_loop_scope=function'"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "smoke-receipt-restore"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend-py && PYTHONPATH=. python -m pytest tests/test_restore_smoke_receipts.py tests/test_archive_smoke_receipts.py tests/test_smoke_receipt.py --import-mode=importlib -q -c /dev/null --noconftest -p no:cacheprovider"

[[workflows.workflow]]
name = "acceptance-evidence-restore"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend-py && PYTHONPATH=. python -m pytest tests/test_restore_acceptance_evidence.py tests/test_archive_acceptance_evidence.py tests/test_restore_smoke_receipts.py tests/test_archive_smoke_receipts.py tests/test_smoke_receipt.py tests/test_acceptance_storage_harness.py --import-mode=importlib -q -c /dev/null --noconftest -p no:cacheprovider"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "public-course-card-guards"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/pnpm-secure.sh --filter @workspace/university-portal exec vitest run src/pages/degrees/course-card.test.tsx src/pages/degrees.test.tsx src/pages/public-university.test.tsx && bash scripts/pnpm-secure.sh --filter @workspace/university-portal run typecheck"

[workflows.workflow.metadata]
isValidation = true

