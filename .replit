[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8083
externalPort = 5000

[[ports]]
localPort = 20675
externalPort = 3000

[[ports]]
localPort = 20676
externalPort = 3003

[[ports]]
localPort = 20677
externalPort = 4200

[nix]
channel = "stable-25_05"
packages = ["cacert", "cargo", "libffi", "libiconv", "libxcrypt", "openssl", "pkg-config", "postgresql", "rapidfuzz-cpp", "rustc", "taskflow", "xcodebuild", "zlib"]

[userenv]

[userenv.shared]
GITHUB_PUSH_URL = "https://github.com/Studyinfocentre/University-and-course-managment.git"
WLV_SEARCHSTAX_TOKEN = "d94d88f1dfd335e6bb4ef870b2c1ff29faf95bb6"
DURHAM_SEARCHSTAX_TOKEN = "75c41a510e054668f69fae93cf05b755ba027b7c"
LEEDSTRINITY_SEARCHSTAX_TOKEN = "877b10aff7b0b0d2d452d592169782516d929bad"
DEFAULT_FROM_EMAIL = "noreply@studyinfocentre.com"
SES_REGION = "ap-south-1"
EMAIL_TRANSPORT = "smtp"
SMTP_HOST = "email-smtp.ap-south-1.amazonaws.com"
SMTP_PORT = "587"
SMTP_USE_TLS = "true"
ADMIN_EMAIL = "au@studyinfocentre.com"

[userenv.development]
PLAYWRIGHT_NODEJS_PATH = "/home/runner/workspace/scripts/secure-browser-node.sh"
